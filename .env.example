# Chave de autenticação da API (obrigatório)
API_KEY=your-api-key-here

# Porta do servidor (padrão: 3001)
PORT=3001

# Caminho do executável do Chromium na VM (Debian 12)
CHROMIUM_PATH=/usr/bin/chromium

# Proxy para o Playwright (opcional — usar quando a VM estiver bloqueada pelo site alvo)
# PROXY_SERVER=http://HOST:PORT
# PROXY_USERNAME=usuario
# PROXY_PASSWORD=senha

